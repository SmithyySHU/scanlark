# Copy to .env.production on the VPS and replace every CHANGE_ME value.
# Do not commit .env.production.

# Domain / TLS
SCANLARK_PUBLIC_DOMAIN=scanlark.com
SCANLARK_WWW_DOMAIN=www.scanlark.com
SCANLARK_APP_DOMAIN=app.scanlark.com
CADDY_ACME_EMAIL=contact@scanlark.com

# Postgres
POSTGRES_DB=scanlark
POSTGRES_USER=scanlark
POSTGRES_PASSWORD=CHANGE_ME_STRONG_POSTGRES_PASSWORD
DATABASE_URL=postgres://scanlark:CHANGE_ME_STRONG_POSTGRES_PASSWORD@postgres:5432/scanlark

# Runtime
NODE_ENV=production
DEV_BYPASS_AUTH=false
AUTH_COOKIE_NAME=ls_session
SESSION_SECRET=CHANGE_ME_32_PLUS_CHARACTER_RANDOM_SECRET
REPORT_SHARE_TOKEN_SECRET=CHANGE_ME_32_PLUS_CHARACTER_RANDOM_SHARE_SECRET
API_INTERNAL_TOKEN=CHANGE_ME_32_PLUS_CHARACTER_RANDOM_INTERNAL_TOKEN
INTERNAL_ONLY_MODE=true
INTERNAL_ADMIN_EMAILS=admin@example.com
# Isolated Operations Email module. Keep disabled until its staged rollout.
OPERATIONS_EMAIL_MODULE_ENABLED=false
OPERATIONS_REPLY_TO_EMAIL=contact@scanlark.com
OPERATIONS_EMAIL_MAX_ATTACHMENT_BYTES=10485760
OPERATIONS_EMAIL_MAX_ATTACHMENTS_TOTAL_BYTES=20971520
OPERATIONS_EMAIL_MAX_ESTIMATED_MIME_BYTES=29360128
# Checkpoint 5 SMTP queue. Keep real delivery disabled during development.
OPERATIONS_EMAIL_REAL_SEND_MODE=disabled
OPERATIONS_EMAIL_REAL_SEND_ALLOWED_RECIPIENTS=
OPERATIONS_EMAIL_TEST_ALLOWED_RECIPIENTS=connor@scanlark.com,support@scanlark.com
OPERATIONS_EMAIL_SMTP_HOST=
OPERATIONS_EMAIL_SMTP_PORT=587
OPERATIONS_EMAIL_SMTP_SECURITY=starttls
OPERATIONS_EMAIL_SMTP_USERNAME=
OPERATIONS_EMAIL_SMTP_PASSWORD=
OPERATIONS_EMAIL_SMTP_CONNECTION_TIMEOUT_MS=10000
OPERATIONS_EMAIL_SMTP_GREETING_TIMEOUT_MS=10000
OPERATIONS_EMAIL_SMTP_SOCKET_TIMEOUT_MS=30000
OPERATIONS_EMAIL_SMTP_FROM_NAME=Connor Smith
OPERATIONS_EMAIL_SMTP_FROM_ADDRESS=connor@scanlark.com
OPERATIONS_EMAIL_SMTP_REPLY_TO_ADDRESS=contact@scanlark.com
OPERATIONS_EMAIL_SMTP_MAX_AUTOMATIC_ATTEMPTS=3
OPERATIONS_EMAIL_SMTP_RETRY_BASE_SECONDS=30
OPERATIONS_EMAIL_SMTP_RETRY_MAX_SECONDS=900
OPERATIONS_EMAIL_SMTP_WORKER_POLL_MS=1500
OPERATIONS_EMAIL_SMTP_WORKER_LEASE_SECONDS=120
OPERATIONS_EMAIL_SMTP_READINESS_INTERVAL_MS=300000
# IONOS IMAP credentials are consumed by the worker only.
OPERATIONS_EMAIL_IMAP_HOST=
OPERATIONS_EMAIL_IMAP_PORT=993
OPERATIONS_EMAIL_IMAP_SECURITY_MODE=tls
OPERATIONS_EMAIL_IMAP_USERNAME=
OPERATIONS_EMAIL_IMAP_PASSWORD=
OPERATIONS_EMAIL_IMAP_SENT_MAILBOX=
OPERATIONS_EMAIL_IMAP_CONNECTION_TIMEOUT_MS=10000
OPERATIONS_EMAIL_IMAP_SOCKET_TIMEOUT_MS=30000
OPERATIONS_EMAIL_SENT_COPY_MAX_ATTEMPTS=3
OPERATIONS_EMAIL_SENT_COPY_RETRY_BASE_MS=30000
OPERATIONS_EMAIL_SENT_COPY_RETRY_MAX_MS=900000
OPERATIONS_EMAIL_SENT_COPY_WORKER_POLL_MS=2000
OPERATIONS_EMAIL_SENT_COPY_WORKER_LEASE_SECONDS=120
OPERATIONS_EMAIL_SENT_COPY_MAILBOX_CACHE_MS=300000
PUBLIC_CONTACT_EMAIL=contact@scanlark.com
PUBLIC_SITE_URL=https://scanlark.com
EMAIL_ASSET_BASE_URL=https://scanlark.com/assets/email
OPERATIONS_SENDER_NAME=Your Name
OPERATIONS_SENDER_EMAIL=you@example.com
OPERATIONS_SENDER_IDENTITIES=[{"key":"connor","name":"Connor Smith","email":"connor@scanlark.com"}]
OPERATIONS_DEFAULT_SIGNATURE_MODE=use_mailbox_signature
OPERATIONS_DEFAULT_FOLLOW_UP_BUSINESS_DAYS=
OPERATIONS_QUOTE_PREFIX=SL-Q
OPERATIONS_WORK_ORDER_PREFIX=SL-W
OPERATIONS_DEFAULT_CURRENCY=GBP
OPERATIONS_DEFAULT_QUOTE_VALID_DAYS=14
OPERATIONS_BUSINESS_VAT_REGISTERED=false
OPERATIONS_VAT_RATE_PERCENT=20
OPERATIONS_SERVICE_PREFIX=SL-S
OPERATIONS_DEFAULT_SERVICE_CURRENCY=GBP
OPERATIONS_DEFAULT_REPORT_DAY=1
OPERATIONS_DEFAULT_REVIEW_INTERVAL_DAYS=90
OPERATIONS_RENEWAL_REMINDER_DAYS=30
OPERATIONS_DEFAULT_ALLOWANCE_ROLLOVER=false
API_JSON_LIMIT=256kb
API_WRITE_RATE_LIMIT_PER_MINUTE=120
PUBLIC_REPORT_RATE_LIMIT_PER_MINUTE=120
SCAN_ACTION_RATE_LIMIT_PER_10_MINUTES=20
LINK_RECHECK_RATE_LIMIT_PER_10_MINUTES=30
TEST_EMAIL_RATE_LIMIT_PER_10_MINUTES=5
SHARE_ACTION_RATE_LIMIT_PER_10_MINUTES=20
IGNORE_RULE_RATE_LIMIT_PER_10_MINUTES=30
# Comma-separated internal admin allowlist. Leave empty to disable admin access.
ADMIN_EMAILS=admin@example.com

# Private app URLs
APP_URL=https://app.scanlark.com
WEB_ORIGIN=https://app.scanlark.com
API_ORIGIN=https://app.scanlark.com/api
VITE_PUBLIC_SITE_URL=https://scanlark.com
VITE_OPERATIONS_WEBMAIL_URL=https://mail.ionos.co.uk/
VITE_APP_URL=https://app.scanlark.com
VITE_API_BASE=/api

# Worker
WORKER_API_BASE=http://api:3001
UPTIME_TICK_MS=60000
UPTIME_BATCH_SIZE=25

# Email / SMTP
EMAIL_ENABLED=true
EMAIL_FROM="Scanlark <alerts@scanlark.com>"
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=CHANGE_ME_SMTP_USER
SMTP_PASS=CHANGE_ME_SMTP_PASSWORD
EMAIL_TEST_TO=
